<Window x:Class="SystemPodatkowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SystemPodatkowy.ViewModels"
        mc:Ignorable="d"
        Title="System Rozliczania Podatków" Height="450" Width="800">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            
            <Button Content="Wczytaj Podatników z Bazy"
                    Command="{Binding WczytajPodatnikowCommand}"
                    Padding="10"
                    Margin="0,0,10,0"/>

            <Button Content="Dodaj Nowego Podatnika"
                    Command="{Binding DodajPodatnikaCommand}"
                    Padding="10"
                    Margin="0,0,10,0"/>
            
            <Button Content="Zarządzaj Stawkami" 
                    Command="{Binding OtworzStawkiCommand}" 
                    Padding="10" 
                    Background="LightSteelBlue"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Podatnicy}" SelectedItem="{Binding WybranyPodatnik}" 
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
        <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding PodatnikID}" />
            <DataGridTextColumn Header="Nazwa/Nazwisko" Binding="{Binding NazwaWlasna_Nazwisko}" />
            <DataGridTextColumn Header="Imię" Binding="{Binding Imie}" />
            <DataGridTextColumn Header="NIP" Binding="{Binding NIP}" />
            <DataGridTextColumn Header="PESEL" Binding="{Binding PESEL}" />
            <DataGridTextColumn Header="Miejscowość" Binding="{Binding Miejscowosc}" />
        </DataGrid.Columns>
    </DataGrid>

        <GroupBox Grid.Row="3" Header="Karta Podatnika (Szczegóły)" Margin="0,5,0,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <Button Content="Zaksięguj Wpłatę" Command="{Binding DodajWplateCommand}" Padding="5" Margin="0,0,10,0"/>
                    <Button Content="Dodaj Powierzchnię" Command="{Binding DodajPowierzchnieCommand}" Padding="5" Margin="0,0,10,0"/>
                    <Button Content="Generuj Deklarację" Command="{Binding GenerujDeklaracjeCommand}" Padding="5" Background="LightGoldenrodYellow"/>
                </StackPanel>

                <TabControl Grid.Row="1">

                    <TabItem Header="Zaksięgowane Wpłaty">
                        <DataGrid ItemsSource="{Binding WybranyPodatnik.Wplaty}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data Wpływu" Binding="{Binding DataWplywu, StringFormat=d}" />
                                <DataGridTextColumn Header="Kwota" Binding="{Binding KwotaWplaty, StringFormat=C}" />
                                <DataGridTextColumn Header="Sposób Wpłaty" Binding="{Binding SposobWplaty}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Powierzchnie (Działki)">
                        <DataGrid ItemsSource="{Binding WybranyPodatnik.Powierzchnie}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Obręb" Binding="{Binding ObrebEwidencyjny}" />
                                <DataGridTextColumn Header="Nr Działki" Binding="{Binding NumerDzialki}" />
                                <DataGridTextColumn Header="Nr Księgi Wieczystej" Binding="{Binding NumerKsiegiWieczystej}" />
                                <DataGridTextColumn Header="Adres" Binding="{Binding Adres}" />
                                <DataGridTextColumn Header="Powierzchnia (m²)" Binding="{Binding PowCalkowitaM2}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Złożone Deklaracje">
                        <DataGrid ItemsSource="{Binding WybranyPodatnik.Deklaracje}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rok" Binding="{Binding Rok}" />
                                <DataGridTextColumn Header="Data Złożenia" Binding="{Binding DataZlozenia, StringFormat=d}" />
                                <DataGridTextColumn Header="Typ Dokumentu" Binding="{Binding TypDokumentu}" />
                                <DataGridTextColumn Header="Łączna Kwota (PLN)" Binding="{Binding LacznaKwotaPodatku, StringFormat=C}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
