<Window x:Class="SystemPodatkowy.StawkiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarządzanie Stawkami Podatkowymi" Height="450" Width="550" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Dodaj nową stawkę" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Rok podatkowy:" Margin="0,5,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NowaStawka.RokPodatkowy, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,10,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Przedmiot:" Margin="0,5,10,5" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding NowaStawka.PrzedmiotOpodatkowania}" Margin="0,5,10,5">
                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Budynki mieszkalne</System:String>
                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Budynki związane z prowadzeniem działalności gospodarczej</System:String>
                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Grunty pozostałe</System:String>
                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Grunty związane z prowadzeniem działalności gospodarczej</System:String>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Stawka za m² (PLN):" Margin="0,5,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NowaStawka.StawkaZaM2}" Margin="0,5,10,5"/>

                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Content="Dodaj Stawkę" Command="{Binding ZapiszStawkeCommand}" Width="100" Margin="0,5,0,5"/>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ListaStawek}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rok" Binding="{Binding RokPodatkowy}" />
                <DataGridTextColumn Header="Przedmiot Opodatkowania" Binding="{Binding PrzedmiotOpodatkowania}" Width="*"/>
                <DataGridTextColumn Header="Stawka (m²)" Binding="{Binding StawkaZaM2, StringFormat=C}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>