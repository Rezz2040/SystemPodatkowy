<Window x:Class="SystemPodatkowy.TaxRatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarządzanie Stawkami Podatkowymi" Height="400" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Dodaj nową stawkę" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Rok Podatkowy:" Margin="0,5,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewTaxRate.TaxYear, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Przedmiot Opodatkowania:" Margin="0,5,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewTaxRate.SubjectOfTaxation, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Stawka za m² (PLN):" Margin="0,5,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewTaxRate.RatePerSqm, UpdateSourceTrigger=LostFocus}" TextChanged="DecimalTextBox_TextChanged" Margin="0,5,0,5"/>
                
                <Button Grid.Row="3" Grid.Column="1" Content="Zapisz Stawkę" Command="{Binding SaveTaxRateCommand}" Width="100" Height="30" HorizontalAlignment="Right" Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="1" Text="Zdefiniowane stawki:" FontWeight="Bold" Margin="0,0,0,5"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding TaxRatesList}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,5,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rok" Binding="{Binding TaxYear}" Width="80"/>
                <DataGridTextColumn Header="Przedmiot" Binding="{Binding SubjectOfTaxation}" Width="*"/>
                <DataGridTextColumn Header="Stawka/m²" Binding="{Binding RatePerSqm, StringFormat=C}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>