<Window x:Class="SystemPodatkowy.Views.AddTaxpayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj Nowego Podatnika" Height="450" Width="400" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Typ podmiotu:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding NewTaxpayer.EntityType}" Margin="0,5,0,5">
            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Osoba fizyczna</System:String>
            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Firma</System:String>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nazwa / Nazwisko:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewTaxpayer.CompanyNameOrLastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Imię:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewTaxpayer.FirstName, ValidatesOnDataErrors=True}" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="PESEL:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NewTaxpayer.PersonalIdNumber, ValidatesOnDataErrors=True}" MaxLength="11" PreviewTextInput="NumberValidationTextBox" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="NIP:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NewTaxpayer.TaxIdNumber, ValidatesOnDataErrors=True}" MaxLength="10" PreviewTextInput="NumberValidationTextBox" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Miejscowość:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding NewTaxpayer.City, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Kod Pocztowy:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding NewTaxpayer.PostalCode, ValidatesOnDataErrors=True}" MaxLength="6" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Ulica:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding NewTaxpayer.Street, ValidatesOnDataErrors=True}" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Nr domu/lokalu:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding NewTaxpayer.HouseAndFlatNumber, ValidatesOnDataErrors=True}" Margin="0,5,0,5"/>

        <Button Grid.Row="9" Grid.Column="1" Content="Zapisz" Command="{Binding SaveCommand}" Width="100" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,20,0,0"/>
    </Grid>
</Window>