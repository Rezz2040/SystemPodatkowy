<Window x:Class="SystemPodatkowy.Views.AddPropertyAreaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj Powierzchnię" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Obręb ewidencyjny:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewPropertyArea.CadastralDistrict, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Numer działki:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewPropertyArea.PlotNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Nr Księgi Wieczystej:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewPropertyArea.LandRegisteredNumber}" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Adres (opcjonalnie):" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NewPropertyArea.Address}" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pow. całkowita (m²):" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NewPropertyArea.TotalAreaSqm, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" PreviewTextInput="NumberValidationTextBox" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Udział własności (%):" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PercentageShare, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,5"/>

        <Button Grid.Row="6" Grid.Column="1" Content="Zapisz działkę" Command="{Binding SaveCommand}" Width="100" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,0,0"/>
    </Grid>
</Window>