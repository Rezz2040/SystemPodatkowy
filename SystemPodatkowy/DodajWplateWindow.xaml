<Window x:Class="SystemPodatkowy.DodajWplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zaksięguj Wpłatę" Height="250" Width="350" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Data wpływu:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding NowaWplata.DataWplywu}" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Kwota (PLN):" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NowaWplata.KwotaWplaty, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sposób wpłaty:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding NowaWplata.SposobWplaty}" Margin="0,5,0,5">
            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Przelew bankowy</System:String>
            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Gotówka w kasie</System:String>
            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Karta płatnicza</System:String>
        </ComboBox>

        <Button Grid.Row="3" Grid.Column="1" Content="Zaksięguj" Command="{Binding ZapiszCommand}" Width="100" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,0,0"/>
    </Grid>
</Window>